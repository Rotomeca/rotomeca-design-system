{
  "name": "@rotomeca/design-system",
  "version": "1.1.0",
  "description": "Design system de Web Components (custom elements, Shadow DOM) en TypeScript + LESS, palette automnale, thèmes clair et sombre.",
  "keywords": [
    "design-system",
    "web-components",
    "custom-elements",
    "shadow-dom",
    "typescript",
    "less",
    "ui"
  ],
  "homepage": "https://github.com/Rotomeca/rotomeca-design-system#readme",
  "bugs": {
    "url": "https://github.com/Rotomeca/rotomeca-design-system/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rotomeca/rotomeca-design-system.git"
  },
  "license": "ISC",
  "author": "Rotomeca",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/core/scripts/jsx/jsx-runtime.d.ts",
      "default": "./dist/core/scripts/jsx/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/core/scripts/jsx/jsx-dev-runtime.d.ts",
      "default": "./dist/core/scripts/jsx/jsx-dev-runtime.js"
    },
    "./css": "./dist/design-system.css",
    "./less": "./src/core/styles/design-system.less",
    "./package.json": "./package.json",
    "./bundle": "./out/rotomeca-design-system.js",
    "./css/min": "./out/rotomeca-design-system.css",
    "./icons/*": "./dist/icons/*"
  },
  "files": [
    "dist",
    "out",
    "src/core/styles",
    "!**/*.map"
  ],
  "sideEffects": [
    "*.css",
    "*.less"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"for (const d of ['dist','out','playground/.build']) require('fs').rmSync(d,{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "build:dist": "tsc",
    "build:out": "node scripts/build.mjs",
    "build": "pnpm clean && pnpm build:dist && pnpm build:css:dist && pnpm build:out && pnpm build:css:out && pnpm build:icons",
    "prepublishOnly": "pnpm test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm typecheck && pnpm lint && pnpm build",
    "build:css:dist": "lessc src/core/styles/design-system.less dist/design-system.css",
    "build:css:out": "esbuild dist/design-system.css --minify --outfile=out/rotomeca-design-system.css",
    "dev": "pnpm run clean && pnpm run test && node scripts/dev.mjs",
    "build:icons": "node scripts/copy-icons.mjs",
    "docs:build": "node scripts/docs.mjs",
    "docs:dev": "node scripts/docs.mjs --watch"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.15.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "less": "^4.9.1",
    "lucide-static": "^1.67.0",
    "prettier": "^3.9.10",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.0"
  },
  "dependencies": {
    "@rotomeca/event": "^5.0.0",
    "@rotomeca/rop": "^6.0.0",
    "@rotomeca/utils": "^7.0.3"
  }
}
