{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@rotomeca/ds-jsx",
    "paths": {
      "@rotomeca/ds-jsx/jsx-runtime": ["./src/core/scripts/jsx/jsx-runtime.ts"],
      "@rotomeca/ds-jsx/jsx-dev-runtime": ["./src/core/scripts/jsx/jsx-dev-runtime.ts"]
    }
  },
  "include": ["src"]
}
